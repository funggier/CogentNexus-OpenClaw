{
  "id": "cogentnexus-rotation",
  "name": "CogentNexus Rotation Controller",
  "description": "Validate a durable CogentNexus ROTATE handoff and start one idempotently identified TaskFlow worker.",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "cogentRoot": {
        "type": "string"
      },
      "pythonCommand": {
        "type": "string"
      },
      "agentId": {
        "type": "string"
      },
      "model": {
        "type": "string"
      },
      "timeoutSeconds": {
        "type": "integer",
        "minimum": 60,
        "maximum": 86400
      },
      "autoResume": {
        "type": "boolean",
        "description": "Schedule one durable continuation turn after a resumable interruption."
      },
      "autoResumeDelayMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 60000
      },
      "autoRotate": {
        "type": "boolean",
        "description": "Automatically start a clean TaskFlow worker for a verified ROTATE handoff."
      },
      "workspaceDir": {
        "type": "string",
        "description": "Workspace containing .cogent/workflows completion outboxes."
      },
      "autoWorkflowCompletion": {
        "type": "boolean",
        "description": "Automatically wake the bound owner when a workflow reaches a terminal state."
      },
      "completionPollMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 300000
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "cogent_rotation",
      "cogent_workflow_start"
    ]
  },
  "toolMetadata": {
    "cogent_rotation": {
      "optional": true
    },
    "cogent_workflow_start": {
      "optional": true
    }
  }
}
