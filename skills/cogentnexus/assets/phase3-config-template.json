{
  "schemaVersion": 1,
  "supervisor": {
    "intervalSeconds": 300,
    "commandTimeoutSeconds": 30,
    "confirmDelaySeconds": 1,
    "verifyDelaySeconds": 3,
    "cooldownSeconds": 300,
    "maximumRecoveriesPerHour": 3,
    "ollamaMode": "auto",
    "allowOllamaStart": false
  },
  "concurrency": {
    "mode": "fixed",
    "inferenceLanes": 1,
    "maxInferenceLanes": 1,
    "executionLanes": 2,
    "verificationLanes": 2,
    "supervisorLanes": 1,
    "minimumFreeMemoryGB": 2,
    "leaseSeconds": 1800
  },
  "contextContinuity": {
    "softLimit": 0.25,
    "handoffLimit": 0.35,
    "criticalLimit": 0.45,
    "reserveTokens": 16384,
    "leaseSeconds": 1800,
    "autoMonitor": true
  },
  "workflowAutomation": {
    "enabled": true,
    "maximumLaunchesPerTick": 2
  }
}
